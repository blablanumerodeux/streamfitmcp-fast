# StreamFit API credentials
STREAMFIT_EMAIL=your@email.com
STREAMFIT_PIN=your_pin_code

# Optional — only needed if using a non-default API endpoint
# STREAMFIT_BASE_URL=https://api.streamfit.com

# Optional — pre-set auth tokens (from browser session)
# These avoid the "Update your app" error when the API version is outdated
# STREAMFIT_ACCESS_TOKEN=your_access_token
# STREAMFIT_CLIENT=your_client_id
# STREAMFIT_EXPIRY=token_expiry_timestamp
# STREAMFIT_UID=your_uid
