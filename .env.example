# StreamFit API credentials
# Option 1: email + PIN (Devise token auth — mobile app flow)
STREAMFIT_EMAIL=your@email.com
STREAMFIT_PIN=your_pin

# Option 2: pre-existing tokens (from a previous web/app session)
# Get these by logging into https://go.streamfit.com and inspecting
# the access-token, client, and uid request headers in DevTools
STREAMFIT_ACCESS_TOKEN=
STREAMFIT_CLIENT=
STREAMFIT_EXPIRY=
STREAMFIT_UID=

# CrossFit 514 channel ID (auto-detected if not set)
STREAMFIT_CHANNEL_ID=812
